# Copy to server/.env, never commit the real .env
DOMAIN=mathformula.example.com
# Use: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_READ_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
# Optional explicitly pre-issued token (expires at Groww's daily expiry)
GROWW_ACCESS_TOKEN=
AUTO_NSE_IMPORT=1
NSE_BACKFILL_DAYS=130
SHORTLIST_SIZE=30
MIN_AVG_TRADED_VALUE_INR=10000000
LOG_LEVEL=INFO
# Operator-maintained exchange holiday YYYY-MM-DD list; should integrate verified exchange calendar
NSE_HOLIDAYS=
# Optional HTTPS webhooks for candidate alerts (server-only, NOT Android FCM)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
